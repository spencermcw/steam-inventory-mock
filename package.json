{
  "name": "steam-inventory-mock",
  "version": "0.1.0",
  "description": "An in-process mock of Steam's Inventory Service (ISteamInventory): exchange formulas, bundle and generator expansion, per-item tags, tag tools, dynamic properties, playtime drops and promo grants — driven by a virtual clock and a seedable RNG.",
  "main": "index.js",
  "types": "client.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js test/conformance/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:conformance": "node --test test/conformance/*.test.js",
    "test:conformance:report": "node test/conformance-report.js",
    "test:conformance:example": "node test/conformance-report.js --target ./test/example-steam-target.js",
    "demo": "node demo/playthrough.js",
    "demo:save-load": "node demo/save-load.js",
    "demo:distribution": "node demo/distribution.js"
  },
  "files": [
    "index.js",
    "client.d.ts",
    "lib",
    "examples",
    "test",
    "README.md",
    "LICENSE",
    "docs/coverage.md"
  ],
  "keywords": [
    "steam",
    "steamworks",
    "inventory",
    "isteaminventory",
    "mock",
    "itemdef",
    "economy"
  ],
  "license": "MIT",
  "author": "spencermcw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermcw/steam-inventory-mock.git"
  },
  "bugs": {
    "url": "https://github.com/spencermcw/steam-inventory-mock/issues"
  },
  "homepage": "https://github.com/spencermcw/steam-inventory-mock#readme"
}
